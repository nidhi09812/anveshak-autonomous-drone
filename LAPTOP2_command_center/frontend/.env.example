# WebSocket URL of the LAPTOP2 relay server's /ws endpoint.
# Local dev default: ws://localhost:8000/ws
# Production: your deployed relay's public WSS URL, e.g.
#   VITE_RELAY_WS_URL=wss://anveshak-relay.onrender.com/ws
VITE_RELAY_WS_URL=ws://localhost:8000/ws

# URL of the LAPTOP1 field backend (FastAPI + YOLO), used by the built-in
# "Upload a field image" panel on this dashboard.
# Local dev default: http://127.0.0.1:8000
# Production: your deployed field backend's public HTTPS URL, e.g.
#   VITE_API_BASE_URL=https://anveshak-field-backend.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000
